# i3 config file (v4)
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

set $foreground    #EAD9C9
set $background    #191724
set $color0        #1F1F28
set $color1        #F2B2C6
set $color2        #A6D8D0
set $color3        #E6C57A
set $color4        #7F9CDA
set $color5        #B57D99
set $color6        #B8E1D8
set $color7        #F5E0DC
set $color8        #4B4B4D
set $color9        #F28FAD
set $color10       #A6D8D0
set $color11       #E6C57A
set $color12       #7F9CDA
set $color13       #B57D99
set $color14       #A6D8D0
set $color15       #F5E0DC
set $color16       #EBA0AC
set $color17       #F2B2C6

# Window header settings
client.focused            $color8           $color8        $foreground     $color7
client.focused_inactive   $background       $background    $color7         $color0
client.unfocused          $color0           $background    $color8         $color0
client.urgent             $color1           $color1        $foreground     $color1
client.background         $background

set $mod Mod1

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
#font pango:monospace 6
font pango:Hack Nerd Font 9

# start a terminal
bindsym $mod+Return exec alacritty

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
exec --no-startup-id dex --autostart --environment i3

# NetworkManager is the most popular way to manage wireless networks on Linux,
# and nm-applet is a desktop environment-independent system tray GUI for it.
exec --no-startup-id nm-applet

# Ctrl as escape
#exec --no-startup-id "xcape -e 'Control_L=Escape'"

# Faster key rate on hold
exec --no-startup-id "xset r rate 180 40"

# Turn off screensaver
exec --no-startup-id "xset s off -dpms s noblank"

exec sh ~/.screenlayout/2_external_monitors.sh

# Wallpaper
exec --no-startup-id feh --bg-fill \
    ~/Pictures/wallpapers/wallpaper1.jpg \
    ~/Pictures/wallpapers/wallpaper1.jpg \
    ~/Pictures/wallpapers/wallpaper1.jpg

# enable compositor
exec --no-startup-id "picom --config ~/.config/picom/picom.conf"

# Run applications on startup
exec --no-startup-id brave &
exec --no-startup-id slack &
exec --no-startup-id signal-desktop &

# start dpt tmux
exec --no-startup-id sh ~/Documents/scripts/tmux-dpt.sh

# Use pactl to adjust volume in PulseAudio.
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# kill focused window
bindsym $mod+Shift+q kill

bindsym $mod+grave exec "dunstctl history-pop"
bindsym $mod+Escape exec "dunstctl close-all"

#################################### COLEMAK keybindings ####################################

# start rofi (a program launcher)
bindsym $mod+s exec "rofi -show drun"
bindsym $mod+g exec passmenu

# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+p restart

bindsym $mod+Shift+l move container to workspace 
bindsym $mod+Shift+m move container to workspace 
bindsym $mod+Shift+semicolon move container to workspace 
bindsym $mod+Shift+u move container to workspace 
bindsym $mod+Shift+y move container to workspace 
bindsym $mod+Shift+k move container to workspace 

bindsym $mod+n focus left
bindsym $mod+e focus down
bindsym $mod+i focus up
bindsym $mod+o focus right

# move focused window
bindsym $mod+Shift+n move left
bindsym $mod+Shift+e move down
bindsym $mod+Shift+i move up
bindsym $mod+Shift+o move right

bindsym $mod+l workspace 
bindsym $mod+m workspace 
bindsym $mod+semicolon workspace 
bindsym $mod+u workspace 
bindsym $mod+y workspace 
bindsym $mod+k workspace 

bindsym $mod+f layout toggle split
# mute mic
bindsym $mod+j exec --no-startup-id bash -c 'pactl list sources | grep -E "Name: " | awk "{print \$2}" | xargs -I {} pactl set-source-mute {} toggle'

